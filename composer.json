{
    "name": "unesco/heritage-api",
    "description": "UNESCO World Heritage Sites API",
    "type": "project",
    "require": {
        "php": "^8.1",
        "bramus/router": "^1.6",
        "firebase/php-jwt": "^7.0",
        "illuminate/database": "^10.0",
        "php-di/php-di": "^7.1",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.0",
        "symfony/var-dumper": "^6.0",
        "vimeo/psalm": "^6.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
